# Copy this file to values.secret.yaml (gitignored) and fill in real values.
# install.sh loads values.secret.yaml if present; it refuses to proceed
# without it.

apitestrig:
  extraEnvVarsSecret:
    KEYCLOAK_CLIENT_SECRET: "changeme"
    INDIVIDUAL_ID: "changeme"                # test identity -- PII, keep out of git

  # --- Conformance plan config (private JWKS) ---
  # Only needed if apitestrig.surfaces includes "conformance". Two ways to
  # supply it -- pick ONE:
  #
  # A) Point at a Secret you already created/manage out-of-band (kubectl
  #    create secret, sealed-secrets, external-secrets, ...). This is
  #    values.yaml's default (conformancePlanConfig.existingSecret:
  #    "esignet-conformance-plan") -- if that's what you're using, you don't
  #    need anything here; leave this whole conformancePlanConfig block out
  #    of values.secret.yaml entirely.
  #
  # B) Inline the file contents right here instead, so `helm upgrade`
  #    creates and manages the Secret itself -- no separate kubectl step,
  #    no pre-existing Secret required. To use this, set existingSecret to
  #    "" (blank) below to override values.yaml's default and switch the
  #    chart into this mode, then paste your actual plan JSON under `files`.
  #    Filenames must match plans[].config_file's basename exactly (see
  #    config.mosip.json's own _comment block) -- typically
  #    esignet-config.json and esignet-fapi2-config.json.
  #
  # conformancePlanConfig:
  #   enabled: true
  #   existingSecret: ""   # blank = use `files` below instead of a Secret
  #   files:
  #     esignet-config.json: |
  #       { ... paste the real oidcc plan JSON here ... }
  #     esignet-fapi2-config.json: |
  #       { ... paste the real fapi2 plan JSON here ... }

reports:
  s3:
    accessKey: "changeme"
    secretKey: "changeme"
